{
  "name": "@guardhub/web",
  "version": "0.1.0",
  "private": true,
  "description": "GuardHub web UI (Next.js App Router): landing, free scan, account area, admin.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
