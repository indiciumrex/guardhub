; dkim1024.dd.lab.test: as good, but the default selector's RSA key has 1024 bits (dns_depth, test_corpus/README.md).
$ORIGIN dkim1024.dd.lab.test.
$TTL 300
@        IN SOA ns.dns.lab.test. hostmaster.dns.lab.test. 1 7200 3600 1209600 300
@        IN NS  ns.dns.lab.test.
@        IN MX  10 mx.dkim1024.dd.lab.test.
mx       IN A   192.0.2.25
@        IN TXT "v=spf1 mx -all"
_dmarc   IN TXT "v=DMARC1; p=reject"
@        IN CAA 0 issue "lab-ca.test"
_mta-sts IN TXT "v=STSv1; id=20261123"
_smtp._tls IN TXT "v=TLSRPTv1; rua=mailto:tls-reports@dkim1024.dd.lab.test"
_25._tcp.mx IN TLSA 3 1 1 6c3f1c0d9b2a8e5f4d7c6b5a49382716f5e4d3c2b1a09f8e7d6c5b4a39281706
default._domainkey IN TXT "v=DKIM1; k=rsa; p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDdobPK6PPhT4FiW+VY46CEMI00C3foOs1h2Y0h2loEu545wG7pcXrAg94dK5fM8khh31dIGOjFFSefIIfoUed5dw0IPZ+XwnUZtDi4wa0tjv/CiA8Qub5zdpIXdEeXDCiIVQJLulf/BHrCmcomM9Yee16/R2Zcicw4KTQOb4cKnwIDAQAB"
selector2._domainkey IN TXT "v=DKIM1; k=ed25519; p=11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo="
