; openres.dns.lab.test: its own zone (an apex target), well configured for mail, but its
; nameserver (dns-open) also answers recursive questions for anyone -> open_resolver
$ORIGIN openres.dns.lab.test.
$TTL 300
@        IN SOA ns-open.dns.lab.test. hostmaster.openres.dns.lab.test. 1 7200 3600 1209600 300
@        IN NS  ns-open.dns.lab.test.
@        IN MX  10 mx.openres.dns.lab.test.
@        IN TXT "v=spf1 mx -all"
_dmarc   IN TXT "v=DMARC1; p=reject"
