# secrets — never commit real env files
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# go
apps/scanner/bin/
*.test
coverage.out

# node / next
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
Thumbs.db
*.log

# demo target: the fake .env is intentional; the verification token is written at runtime
!ops/demo-target/site/.env
ops/demo-target/site/.well-known/


# local Claude Code state (agent worktrees)
.claude/
ops/demo-target/site/.env.parked
docs/accuracy/raw-results.json

# GitHub App private keys never enter the repository (ADR-0006)
ops/github-app/*.pem

# Validation lab repositories are fixtures and are committed whole (ADR-0006 §10): a committed
# .env and node_modules are exactly what they test. Planted secrets in them are templates.
!test_corpus/repos/*/.env
!test_corpus/repos/**/node_modules/
!test_corpus/repos/**/node_modules/**
