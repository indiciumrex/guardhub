# GuardHub — example environment. Copy to `.env` and replace EVERY `change-me` value.
# Generate strong values with:  python ops/scripts/gen_secrets.py  (writes a ready .env)
# Never commit a real .env (GUARDHUB_STANDARDS §9.1). CI scans for secrets.

# --- public site --------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
WEB_PORT=3000

# --- PostgreSQL ---------------------------------------------------------------------------
# Owner role: runs migrations only. App role: used by the API at runtime (subject to RLS).
POSTGRES_DB=guardhub
POSTGRES_USER=guardhub_owner
POSTGRES_PASSWORD=change-me-owner-password
GUARDHUB_APP_DB_USER=guardhub_app
GUARDHUB_APP_DB_PASSWORD=change-me-app-password

# --- Redis --------------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password

# --- API secrets --------------------------------------------------------------------------
# JWT signing secret: >= 32 random bytes, base64url.
JWT_SECRET=change-me-jwt-secret
# AES-256-GCM key for data at rest (TOTP secrets, evidence): exactly 32 bytes, base64.
DATA_ENCRYPTION_KEY=change-me-base64-32-bytes
# Only during a key rotation: the OLD key(s), comma-separated, used solely to DECRYPT values not
# yet re-encrypted. Leave empty otherwise (ops/runbooks/production.md "Rotating DATA_ENCRYPTION_KEY").
DATA_ENCRYPTION_KEYS_PREVIOUS=
# HMAC key for hashing client IPs / scan tokens: >= 32 random bytes, base64url.
HASH_PEPPER=change-me-hash-pepper

# Cookies are Secure by default. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true
# Proxies in front of the API that append X-Forwarded-For (web rewrite = 1; add 1 per extra proxy).
TRUSTED_PROXY_HOPS=1

# --- scanner (defaults are the do-no-harm envelope, docs/architecture.md §3) --------------
SCANNER_WORKERS=4
SCANNER_CHECK_CONCURRENCY=3
SCANNER_HOST_RPS=4
SCANNER_MAX_REQUESTS_PER_SCAN=220
SCANNER_REQUEST_TIMEOUT=10s
# Certificate Transparency search for subdomain_takeover discovery (crt.sh JSON API). Empty =
# https://crt.sh/; "off" = DNS-only discovery. Its query carries the verified domain (ADR-0005).
SCANNER_CT_URL=
# Only for the local e2e demo target (compose profile "demo"). Keep empty in production.
SCANNER_ALLOW_PRIVATE_HOSTS=

# --- optional AI seam (§8.4) — leave empty: the core never needs it ----------------------
AI_PROVIDER=
AI_API_KEY=

LOG_LEVEL=info

# --- monitoring + alerts (docs/architecture.md §8; service api-jobs) ----------------------
# Scheduler: projects started per 5-minute tick, and max scheduled scans queued/running at once.
SCHEDULER_BATCH=10
SCHEDULER_MAX_INFLIGHT=2
# Alert e-mail over SMTP. Leave SMTP_HOST empty to skip e-mail alerts (recorded as "skipped").
# SMTP_SECURITY: starttls (port 587) | tls (implicit TLS, port 465). Certificates are verified.
# "none" (plaintext) works ONLY for a host listed in SMTP_INSECURE_HOSTS (a local sink such as
# the demo's mailpit) and never with a username/password. Never commit a real SMTP password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender, e.g. GuardHub <alerts@your-domain.example> (required when SMTP_HOST is set).
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_INSECURE_HOSTS=

# --- error tracking (Sentry protocol; docs/architecture.md §7) — OFF while the DSNs are empty --
# One Sentry project per service; each service is off while its DSN is empty. Never commit real
# DSNs. EU region DSNs look like https://<key>@o<org>.ingest.de.sentry.io/<project-id>.
# api AND api-worker (the relay's upstream host is taken from this DSN):
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_SCANNER=
# Optional shared fallback, used only by a service whose own DSN above is empty.
SENTRY_DSN=
# Defaults to "production".
SENTRY_ENVIRONMENT=production
# api/api-worker have no internet: they send through the `sentry-relay` service, which only
# runs with this compose profile. Set it together with SENTRY_DSN_API.
#COMPOSE_PROFILES=sentry
# Where api/api-worker send (DSN host replaced, key + project kept). Default: the relay.
#SENTRY_RELAY_URL=http://sentry-relay:3000
# Browser error reports via the same-origin /monitoring tunnel: on (default) | off.
#SENTRY_BROWSER=on
# The release is GUARDHUB_VERSION (the image tag), passed to every container by compose.

# --- GitHub repository scanning (ADR-0006; ops/runbooks/production.md §9) ---
# Leave empty until the GitHub App exists: the account page then says "not available yet".
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Directory holding app.pem (the App's private key). Mounted read-only at /run/github-app.
GITHUB_APP_KEY_DIR=./ops/github-app
# Set once app.pem is in GITHUB_APP_KEY_DIR:
GITHUB_PRIVATE_KEY_FILE=
# Empty = api.github.com / api.osv.dev (the validation lab overrides them).
SCANNER_GITHUB_API_URL=
SCANNER_OSV_URL=
