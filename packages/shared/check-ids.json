        { "key": "dmarc_not_enforced", "severity": "low", "params": ["domain"] },
        { "key": "open_resolver", "severity": "medium", "params": ["nameserver"] },
        { "key": "zone_transfer_open", "severity": "medium", "params": ["nameserver"] }
      ]
    }
  ]
}
